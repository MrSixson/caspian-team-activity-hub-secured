# ==========================================
# AI Studio managed
# ==========================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Security settings
# ==========================================

# Origins allowed to call the API from a browser, comma separated.
# Leave EMPTY for same-origin only (the safest default).
# NEVER use "*": the API is authenticated and must not be callable by any site.
ALLOWED_ORIGINS=""

# Set to "true" only when running behind a reverse proxy / Cloud Run,
# so client IPs used for rate limiting are read from X-Forwarded-For.
TRUST_PROXY="false"

# Where the JSON data store lives. The file contains password HASHES and is
# written with 0600 permissions. Keep it outside any web-served directory.
DATA_STORE_PATH="./data_store.json"

# Max accepted request body (TeamSpeak screenshots are sent as data URLs).
BODY_LIMIT="12mb"

# ==========================================
# Initial passwords for the three core accounts
# ==========================================
# These are used ONLY the first time the data store is created (or after a
# system reset). They are hashed with scrypt immediately and never stored,
# logged, or sent to the browser in plaintext.
#
# If you leave one empty, a strong random password is generated at first boot
# and printed to the SERVER CONSOLE exactly once; that account is then forced
# to change its password at first login.
#
# Use a long, unique value per account and never commit a filled-in .env file.
SEED_FOUNDER_PASSWORD=""
SEED_OWNER_PASSWORD=""
SEED_SUPERVISOR_PASSWORD=""
